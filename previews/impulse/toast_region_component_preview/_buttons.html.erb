<%# `showToast()` from the `/toast` import path calls the region's `showToast`, which the demo bundle can reach. %>
<div class="d-flex flex-wrap" style="gap: 8px">
  <button type="button" class="btn btn-outline-secondary btn-sm" onclick="document.querySelector('awc-toast-region').showToast('Copied to clipboard', { variant: 'success', id: 'clipboard-toast' })">Copy link</button>
  <button type="button" class="btn btn-outline-secondary btn-sm" onclick="const region = document.querySelector('awc-toast-region'); region.showToast('Saving goal…', { id: 'save', duration: Infinity }); setTimeout(() => region.showToast('Goal saved', { id: 'save', variant: 'success' }), 1500)">Save</button>
  <button type="button" class="btn btn-outline-secondary btn-sm" onclick="document.querySelector('awc-toast-region').showToast('The server didn’t respond. Your changes are still in the form, so you can try again.', { variant: 'danger', title: 'Couldn’t save the goal' })">Save fails</button>
  <button type="button" class="btn btn-outline-secondary btn-sm" onclick="document.querySelector('awc-toast-region').showToast('You can’t create events before Nov 14, 2026, 8:00 AM.', { variant: 'warning' })">Before cutoff</button>
</div>
