<%= render(Impulse::PopoverComponent.new) do |c| %>
  <% c.with_trigger(class: "btn btn-primary") { "Toggle popover" } %>
  <% c.with_panel do |panel| %>
    <% panel.with_header(class: "d-flex align-items-center") do |header| %>
      <% header.with_title(class: "mr-auto") { "Delete" } %>
      <button type="button" class="btn btn-sm" aria-label="Edit"><i class="bi bi-pencil" aria-hidden="true"></i></button>
      <button type="button" class="btn btn-sm" aria-label="Share"><i class="bi bi-people" aria-hidden="true"></i></button>
    <% end %>
    <% panel.with_body do %>
      <span>Are you sure you want to delete this record? It cannot be undone.</span>

      <div class="mt-3 d-flex align-items-center justify-content-end">
        <button type="button" class="btn btn-sm btn-light" data-action="click->awc-popover#requestHide">Cancel</button>
        <button type="button" class="btn btn-sm btn-danger ml-2">Delete</button>
      </div>
    <% end %>
  <% end %>
<% end %>
