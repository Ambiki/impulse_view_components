<button type="button" id="awc-button" class="btn btn-primary">Anchor</button>
<%= render(
  Impulse::AnchorComponent.new(
    anchor_id: "awc-button",
    active: true,
    class: "popover bs-popover-auto",
    **local_assigns
  )
) do %>
  <div class="arrow" data-arrow></div>
  <%# `auto_size` exposes the space left in the viewport; capping the body with it makes a long list scroll. %>
  <div class="popover-body" style="max-height: var(--awc-auto-size-height); overflow-y: auto">
    <% 1.upto(20) do |item| %>
      <div>Item <%= item %></div>
    <% end %>
  </div>
<% end %>
