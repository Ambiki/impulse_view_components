{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["ES2017", "dom", "dom.iterable"],
    "useDefineForClassFields": false,
    "experimentalDecorators": true,
    "rootDir": "./src",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "src/*": ["./src/*"]
    },
    "types": ["mocha"],
    "strict": true,
    "strictPropertyInitialization": false,
    "declaration": true,
    "declarationMap": true,
    "noEmit": true,
    "outDir": "./dist",
    "sourceMap": false,
    "esModuleInterop": true
  },
  "include": ["src"]
}
