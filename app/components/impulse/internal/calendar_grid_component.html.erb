<%= render(Impulse::BaseRenderer.new(**@system_args)) do %>
  <%= tag.div(class: "#{tag_name}-header", "data-action": ("click->#{tag_name}#handleHeadingClick" if levels_above.any?)) do %>
    <button type="button" class="btn btn-sm btn-light <%= tag_name %>-nav" aria-label="<%= level.previous_label %>" aria-disabled="<%= previous_view_disabled? %>" <%= tag.attributes(disabled: @disabled) %> data-target="<%= tag_name %>.previousButton" data-action="click-><%= tag_name %>#handlePreviousClick">
      <i class="bi bi-chevron-left" aria-hidden="true"></i>
    </button>
    <div id="<%= @heading_id %>" class="<%= tag_name %>-heading" aria-live="polite" data-target="<%= tag_name %>.heading"><%= heading_content %></div>
    <button type="button" class="btn btn-sm btn-light <%= tag_name %>-nav" aria-label="<%= level.next_label %>" aria-disabled="<%= next_view_disabled? %>" <%= tag.attributes(disabled: @disabled) %> data-target="<%= tag_name %>.nextButton" data-action="click-><%= tag_name %>#handleNextClick">
      <i class="bi bi-chevron-right" aria-hidden="true"></i>
    </button>
  <% end %>
  <% levels_above.each do |level_above| %>
    <span id="<%= drill_hint_id(level_above) %>" class="sr-only">
      <%= level_above.drill_hint %>
    </span>
  <% end %>
  <% if hint %>
    <span id="<%= @hint_id %>" class="sr-only">
      <%= hint %>
    </span>
  <% end %>
  <%= tag.table(
    class: "#{tag_name}-grid",
    role: "grid",
    "aria-labelledby": @heading_id,
    "aria-describedby": (@hint_id if hint),
    "aria-disabled": ("true" if @disabled),
    "data-#{level.view_attribute}": level.format_view(@displayed_view),
    "data-target": "#{tag_name}.grid",
    "data-action": "click->#{tag_name}#handleClick keydown->#{tag_name}#handleKeydown focusin->#{tag_name}#handleFocusin"
  ) do %>
    <% if level.weekdays %>
      <thead data-target="<%= tag_name %>.weekdays">
        <tr>
          <% level.weekdays.each do |day| %>
            <th scope="col" abbr="<%= t("date.day_names")[day] %>"><%= t("date.abbr_day_names")[day] %></th>
          <% end %>
        </tr>
      </thead>
    <% end %>
    <tbody data-target="<%= tag_name %>.cells">
      <% level.rows(@displayed_view).each do |row| %>
        <tr>
          <% row.each do |cell| %>
            <%= tag.td("aria-selected": ("true" if selected?(cell))) do %>
              <%= tag.button(
                level.text(cell),
                type: "button",
                class: class_names("#{tag_name}-#{level.cell}", "#{tag_name}-#{level.cell}--outside": outside?(cell)),
                tabindex: (cell == @active_cell) ? 0 : -1,
                "data-date": cell.iso8601,
                "aria-label": level.label(cell),
                "aria-current": ("date" if cell == @today),
                "aria-disabled": ("true" if disabled?(cell)),
                disabled: @disabled
              ) %>
            <% end %>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  <% end %>
<% end %>
