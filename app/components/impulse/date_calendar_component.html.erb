<%= render(Impulse::BaseRenderer.new(**@system_args)) do %>
  <div class="awc-date-calendar-header">
    <button type="button" class="btn btn-sm btn-light awc-date-calendar-nav" aria-label="<%= t("impulse.calendar.previous_month") %>" aria-disabled="<%= previous_month_disabled? %>" data-target="awc-date-calendar.previousButton" data-action="click->awc-date-calendar#handlePreviousClick">
      <i class="bi bi-chevron-left" aria-hidden="true"></i>
    </button>
    <div id="<%= @heading_id %>" class="awc-date-calendar-heading" aria-live="polite" data-target="awc-date-calendar.heading"><%= heading %></div>
    <button type="button" class="btn btn-sm btn-light awc-date-calendar-nav" aria-label="<%= t("impulse.calendar.next_month") %>" aria-disabled="<%= next_month_disabled? %>" data-target="awc-date-calendar.nextButton" data-action="click->awc-date-calendar#handleNextClick">
      <i class="bi bi-chevron-right" aria-hidden="true"></i>
    </button>
  </div>
  <table class="awc-date-calendar-grid" role="grid" aria-labelledby="<%= @heading_id %>" data-month="<%= @displayed_month.strftime("%Y-%m") %>" data-target="awc-date-calendar.grid" data-action="click->awc-date-calendar#handleClick keydown->awc-date-calendar#handleKeydown focusin->awc-date-calendar#handleFocusin">
    <thead data-target="awc-date-calendar.weekdays">
      <tr>
        <% days_of_week.each do |day| %>
          <th scope="col" abbr="<%= t("date.day_names")[day] %>"><%= t("date.abbr_day_names")[day] %></th>
        <% end %>
      </tr>
    </thead>
    <tbody data-target="awc-date-calendar.days">
      <% weeks.each do |week| %>
        <tr>
          <% week.each do |date| %>
            <%= tag.td("aria-selected": ("true" if date == @selected)) do %>
              <%= tag.button(
                date.day,
                type: "button",
                class: class_names("awc-date-calendar-day", "awc-date-calendar-day--outside": date.beginning_of_month != @displayed_month),
                tabindex: (date == @active_day) ? 0 : -1,
                "data-date": date.iso8601,
                "aria-label": I18n.l(date, format: day_format),
                "aria-current": ("date" if date == @today),
                "aria-disabled": ("true" if disabled?(date))
              ) %>
            <% end %>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
