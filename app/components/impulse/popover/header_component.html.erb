<% if nothing_to_show? %>
  <%= title %>
<% else %>
  <%= render(Impulse::BaseRenderer.new(**@system_args)) do %>
    <%= title %>
    <%= content %>
    <% unless @hide_close_button %>
      <button type="button" class="btn btn-light awc-popover-close-btn" data-action="click->awc-popover#requestHide" aria-label="Close">
        <i class="bi bi-x" aria-hidden="true"></i>
      </button>
    <% end %>
  <% end %>
<% end %>
