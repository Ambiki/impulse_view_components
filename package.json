{
  "name": "@ambiki/impulse-view-components",
  "type": "module",
  "version": "0.10.0",
  "description": "A set of JavaScript patterns and Web Components meant to used with the ImpulseViewComponents gem.",
  "author": "Ambitious Idea Labs <info@ambiki.com> (https://ambiki.com/)",
  "contributors": [
    "Abeid Ahmed <aahmed@mysidekicktherapy.com>"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Ambiki/impulse_view_components#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ambiki/impulse_view_components.git"
  },
  "bugs": {
    "url": "https://github.com/Ambiki/impulse_view_components/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "view-components",
    "rails",
    "components"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/elements/*/index.js",
    "./dist/elements/toast/region.js",
    "./dist/elements/toast/toast.js",
    "*.scss",
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "sass": "./dist/index.scss",
      "style": "./dist/styles.css",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./anchor": {
      "types": "./dist/elements/anchor/index.d.ts",
      "default": "./dist/elements/anchor/index.js"
    },
    "./autocomplete": {
      "types": "./dist/elements/autocomplete/index.d.ts",
      "sass": "./dist/elements/autocomplete/index.scss",
      "default": "./dist/elements/autocomplete/index.js"
    },
    "./clipboard-copy": {
      "types": "./dist/elements/clipboard_copy/index.d.ts",
      "default": "./dist/elements/clipboard_copy/index.js"
    },
    "./date-calendar": {
      "types": "./dist/elements/date_calendar/index.d.ts",
      "sass": "./dist/elements/date_calendar/index.scss",
      "default": "./dist/elements/date_calendar/index.js"
    },
    "./dialog": {
      "types": "./dist/elements/dialog/index.d.ts",
      "sass": "./dist/elements/dialog/index.scss",
      "default": "./dist/elements/dialog/index.js"
    },
    "./month-calendar": {
      "types": "./dist/elements/month_calendar/index.d.ts",
      "sass": "./dist/elements/month_calendar/index.scss",
      "default": "./dist/elements/month_calendar/index.js"
    },
    "./popover": {
      "types": "./dist/elements/popover/index.d.ts",
      "sass": "./dist/elements/popover/index.scss",
      "default": "./dist/elements/popover/index.js"
    },
    "./toast": {
      "types": "./dist/elements/toast/index.d.ts",
      "sass": "./dist/elements/toast/index.scss",
      "default": "./dist/elements/toast/index.js"
    },
    "./week-calendar": {
      "types": "./dist/elements/week_calendar/index.d.ts",
      "sass": "./dist/elements/week_calendar/index.scss",
      "default": "./dist/elements/week_calendar/index.js"
    },
    "./year-calendar": {
      "types": "./dist/elements/year_calendar/index.d.ts",
      "sass": "./dist/elements/year_calendar/index.scss",
      "default": "./dist/elements/year_calendar/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "default": "./dist/hooks/index.js"
    },
    "./helpers": {
      "types": "./dist/helpers/index.d.ts",
      "default": "./dist/helpers/index.js"
    },
    "./base": {
      "sass": "./dist/styles/index.scss"
    },
    "./styles.css": "./dist/styles.css"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "concurrently \"yarn build:js\" \"yarn build:css && yarn prefix:css && yarn copy:css\"",
    "build:css": "sass -I node_modules --style=compressed --source-map --embed-source-map --precision=6 src/precompiled.scss demo/app/assets/builds/impulse_view_components.css",
    "build:js": "rollup --config rollup.config.js",
    "build:prod": "NODE_ENV=production yarn build",
    "build:watch": "concurrently \"yarn build:js --watch\" \"yarn build:css --watch\"",
    "clean": "rm -rf dist demo/app/assets/builds/impulse_view_components.*",
    "copy:css": "mkdir -p dist && sed \"/sourceMappingURL=/d\" demo/app/assets/builds/impulse_view_components.css > dist/styles.css",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "prefix:css": "postcss --replace ./demo/app/assets/builds/impulse_view_components.css --use autoprefixer --map",
    "prepublishOnly": "yarn clean && yarn build:prod",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "web-test-runner",
    "test:coverage": "web-test-runner --coverage",
    "test:exports": "node scripts/check-exports.mjs",
    "test:watch": "yarn test --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@ambiki/impulse": "^2.0.0"
  },
  "dependencies": {
    "@ambiki/combobox": "^2.0.1",
    "@floating-ui/dom": "^1.7.4",
    "tabbable": "^6.4.0"
  },
  "devDependencies": {
    "@ambiki/impulse": "^2.0.0",
    "@antfu/eslint-config": "^10.0.0",
    "@open-wc/testing": "^5.0.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/mocha": "^10.0.10",
    "@web/dev-server-esbuild": "^2.0.0",
    "@web/rollup-plugin-copy": "^1.0.0",
    "@web/test-runner": "^1.0.0",
    "@web/test-runner-playwright": "^1.0.0",
    "autoprefixer": "^10.6.1",
    "bootstrap": "4.6",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-format": "^2.0.1",
    "globby": "^16.2.4",
    "idiomorph": "^0.8.0",
    "postcss": "^8.5.31",
    "postcss-cli": "^12.0.0",
    "rollup": "^4.64.10",
    "sass": "^1.105.2",
    "typescript": "^6.0.3",
    "vitepress": "^1.6.4",
    "vitepress-plugin-llms": "^1.14.0"
  },
  "resolutions": {
    "**/oxfmt/tinypool": "~2.1.2",
    "vitepress/vite": "^6.4.4"
  }
}
