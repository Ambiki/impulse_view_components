{
  "name": "@ambiki/impulse-view-components",
  "version": "0.8.0",
  "description": "A set of JavaScript patterns and Web Components meant to used with the ImpulseViewComponents gem.",
  "author": "Ambitious Idea Labs <info@ambiki.com> (https://ambiki.com/)",
  "contributors": [
    "Abeid Ahmed <aahmed@mysidekicktherapy.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ambiki/impulse_view_components.git"
  },
  "bugs": {
    "url": "https://github.com/Ambiki/impulse_view_components/issues"
  },
  "homepage": "https://github.com/Ambiki/impulse_view_components#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./dist/index.js": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dist/elements/anchor": {
      "types": "./dist/elements/anchor/index.d.ts",
      "default": "./dist/elements/anchor/index.js"
    },
    "./dist/elements/autocomplete": {
      "types": "./dist/elements/autocomplete/index.d.ts",
      "sass": "./dist/elements/autocomplete/index.scss",
      "style": "./dist/elements/autocomplete/index.scss",
      "default": "./dist/elements/autocomplete/index.js"
    },
    "./dist/elements/dialog": {
      "types": "./dist/elements/dialog/index.d.ts",
      "sass": "./dist/elements/dialog/index.scss",
      "style": "./dist/elements/dialog/index.scss",
      "default": "./dist/elements/dialog/index.js"
    },
    "./dist/elements/popover": {
      "types": "./dist/elements/popover/index.d.ts",
      "sass": "./dist/elements/popover/index.scss",
      "style": "./dist/elements/popover/index.scss",
      "default": "./dist/elements/popover/index.js"
    },
    "./dist/elements/*.scss": "./dist/elements/*.scss",
    "./dist/elements/*.js": {
      "types": "./dist/elements/*.d.ts",
      "default": "./dist/elements/*.js"
    },
    "./dist/elements/*": {
      "types": "./dist/elements/*.d.ts",
      "default": "./dist/elements/*.js"
    },
    "./dist/hooks/*.js": {
      "types": "./dist/hooks/*.d.ts",
      "default": "./dist/hooks/*.js"
    },
    "./dist/hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "default": "./dist/hooks/*.js"
    },
    "./dist/helpers/*.js": {
      "types": "./dist/helpers/*.d.ts",
      "default": "./dist/helpers/*.js"
    },
    "./dist/helpers/*": {
      "types": "./dist/helpers/*.d.ts",
      "default": "./dist/helpers/*.js"
    },
    "./dist/styles/*": "./dist/styles/*"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "view-components",
    "rails",
    "components"
  ],
  "scripts": {
    "build": "concurrently \"yarn build:js\" \"yarn build:css && yarn prefix:css\"",
    "build:css": "sass -I node_modules --style=compressed --source-map --embed-source-map --precision=6 src/index.scss app/assets/dist/impulse_view_components.css",
    "build:js": "rollup --config rollup.config.js",
    "build:prod": "NODE_ENV=production yarn build",
    "build:watch": "concurrently \"yarn build:js --watch\" \"yarn build:css --watch\"",
    "clean": "rm -rf dist app/assets/dist",
    "lint": "eslint 'src/**/*.ts'",
    "prefix:css": "postcss --replace ./app/assets/dist/impulse_view_components.css --use autoprefixer --map",
    "prepublishOnly": "yarn clean && yarn build:prod",
    "prettier": "prettier --write --log-level warn .",
    "prettier:check": "prettier --check --log-level warn .",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "web-test-runner",
    "test:exports": "node scripts/check-exports.mjs",
    "test:watch": "yarn test --watch"
  },
  "dependencies": {
    "@ambiki/combobox": "^2.0.1",
    "@ambiki/impulse": "^2.0.0-rc.0",
    "@floating-ui/dom": "^1.7.4",
    "tabbable": "^6.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@open-wc/testing": "^5.0.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/mocha": "^10.0.10",
    "@web/dev-server-esbuild": "^2.0.0",
    "@web/rollup-plugin-copy": "^1.0.0",
    "@web/test-runner": "^1.0.0",
    "@web/test-runner-playwright": "^1.0.0",
    "autoprefixer": "^10.6.1",
    "bootstrap": "4.6",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "globby": "^16.2.4",
    "postcss": "^8.5.30",
    "postcss-cli": "^12.0.0",
    "prettier": "^3.9.10",
    "rollup": "^4.64.7",
    "rollup-plugin-uglify": "^6.0.4",
    "sass": "^1.105.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitepress": "^1.6.4",
    "vitepress-plugin-llms": "^1.14.0"
  },
  "license": "MIT"
}
